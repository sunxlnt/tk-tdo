        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Fertility"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Harvesting"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Social"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CourtshipBallads"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HarvestRelatedSongs"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AfterMainHarvest"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PostHarvest"/>
        <AssociatedDanceNote>Group dances in rows or circles</AssociatedDanceNote>
        <CostumeAttireNote>(ornamented shawls, sashes, headgear)</CostumeAttireNote>
        <DurationNote>Up to 3 days, depending on community decision</DurationNote>
        <HistoricalOriginNote>Pre-Christian agrarian societies; institutionalized as a formal village festival</HistoricalOriginNote>
        <ParticipantsNote>Entire village, especially youth</ParticipantsNote>
        <PerformedDuringNote>November</PerformedDuringNote>
        <RegionalVariationNote>Names and rituals vary slightly; some emphasize matchmaking, others focus on harvest celebration; Lom Sel Neh (Northern Kuki regions); Lawn Siel Kai (Central/Chin-Mizo regions)</RegionalVariationNote>
        <SymbolismNote>Gratitude to nature; fertility; community consent in courtship.</SymbolismNote>
        <TellsStoryOf>Transition from labor to rest; renewal of social bonds; symbolic entry into adulthood. The event reflects both agrarian rhythms and social transitions.</TellsStoryOf>
        <schema:alternateName>Lawn Siel Kai</schema:alternateName>
        <schema:description>Annual communal celebration marking completion of seasonal cooperative agricultural labor; also a culturally sanctioned occasion for the formal declaration of romantic relationships or courtship, often leading to marriage.</schema:description>
        <schema:name>Lom Sel Neh</schema:name>
    </owl:NamedIndividual>
    


