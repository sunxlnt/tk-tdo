                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Youth"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <schema:description>Refers performances held typically for the younger generation in society</schema:description>
        <schema:name>Youth Dance</schema:name>
    </owl:Class>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#YouthDormitoryFestival -->

