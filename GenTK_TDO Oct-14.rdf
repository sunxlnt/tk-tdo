        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Anklet"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HandBell"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#WoodenClapper"/>
