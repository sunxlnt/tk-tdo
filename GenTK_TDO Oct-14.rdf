        <CostumeAttireNote>Simple, muted attire; darker/plain colors.</CostumeAttireNote>
        <DanceInstrumentNote>None; focus is on gesture and rhythm.</DanceInstrumentNote>
        <FoodPracticeNote>Simple communal meals, served after the ceremony</FoodPracticeNote>
        <FormationNote>Linear or circular with synchronized steps to a soft beat.</FormationNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</MinCount>
        <MovementNote>Slow, solemn, rhythmic; reflective of mourning</MovementNote>
        <MusicalInstrumentNote>Low-pitched, creating a solemn atmosphere</MusicalInstrumentNote>
        <ParticipantsNote>4–10 or more. (often elders or family)</ParticipantsNote>
        <PerformedDuringNote>Funeral rites, memorial gatherings, and ancestral observances.</PerformedDuringNote>
        <RegionalVariationNote>Variations in chant and attire, depending on clan or region</RegionalVariationNote>
        <SymbolismNote>Mourning, spiritual passage, honoring the dead, solidarity in grief.</SymbolismNote>
        <TellsStoryOf>Journey of the soul, ancestral connection, farewell.</TellsStoryOf>
        <schema:description xml:lang="en">Ritual dance at funerals or remembrances, reflecting sorrow, reverence, and spiritual transition.</schema:description>
        <schema:name>Khongchai Lam</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Khulkon-Lam -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Khulkon-Lam">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#RitualDance"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TravelAttire"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AncientAncestralTradition"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BambooPercussion"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Flute"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SoftDrum"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NorthwesternMyanmar"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Cultural"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MigrationRelatedSongs"/>
        <CostumeAttireNote>simple and symbolic of ancestral times, with head wraps, shawls, and minimal ornaments.</CostumeAttireNote>
        <DanceInstrumentNote>the body is used expressively to tell the story.</DanceInstrumentNote>
        <FormationNote>Diagonal or linear formations simulating migration journey through hills and rivers and settlement</FormationNote>
        <HistoricalOriginNote>oral history and myths of migration from Khul</HistoricalOriginNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5</MinCount>
        <MovementNote>Rhythmic walking and gesture-based movements</MovementNote>
        <OriginPlaceNote>Regions linked to ancestral Kuki legends</OriginPlaceNote>
        <ParticipantsNote>5–10 dancers</ParticipantsNote>
        <SymbolismNote>Origins, migration, struggle, unity, and cultural continuity, symbolizing identity, displacement, and resilience.</SymbolismNote>
        <TellsStoryOf>The tribe’s ancestral migration and search for settlement.</TellsStoryOf>
        <hasSongNote>Folk songs describing phases of the migration and ancestral homeland</hasSongNote>
        <schema:description>A ritual dance depicting the migratory journey of the Thadou-Kuki people from their ancestral village (Khul).</schema:description>
        <rdfs:comment>Depicts the migratory route of Thadou-Kuki</rdfs:comment>
    </owl:NamedIndividual>
    


