        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Hun"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Lom-Sel-Neh"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Sa-Ai"/>
