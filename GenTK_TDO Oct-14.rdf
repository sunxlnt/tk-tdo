        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NorthwesternMyanmar"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Heroic"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HeroicBallads"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#LamentationChants"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#lamkhotna"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AfterBurial"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnCommemoration"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnOccasion"/>
        <AssociatedDanceNote>Ritual dance around the grave or ceremonial space, slow and processional</AssociatedDanceNote>
        <CostumeAttireNote>Family of the deceased may wear distinctive mourning attire</CostumeAttireNote>
        <DurationNote>1 to several days depending on social rank and resources</DurationNote>
        <FoodPracticeNote>Slaughtering of livestock (pigs, mithun) and Distribution of meat among relatives and guests</FoodPracticeNote>
        <HistoricalOriginNote>Rooted in ancestor worship and hierarchical tribal traditions</HistoricalOriginNote>
        <ParticipantsNote>Family members, village elders, ritual specialists (Thempu), and community members</ParticipantsNote>
        <PerformedDuringNote>Shortly after burial; after commemorative period (often a year after death)</PerformedDuringNote>
        <RegionalNote>No longer practiced in Nagaland.</RegionalNote>
        <RegionalVariationNote>May include construction of a hun tombstone or memorial stone (Hunlap); Or integrated into community feasts</RegionalVariationNote>
        <SymbolismNote>Journey of the soul to the ancestral domain; Reaffirmtion of the living community’s bond with their lineage and traditions; Honor, and continuity of kinship obligations;</SymbolismNote>
        <TellsStoryOf>Accomplishments of the deceased—warfare, governance, wealth, or ritual knowledge—and their legacy.</TellsStoryOf>
        <hasSongNote>Narrates the achievements of the deceased;</hasSongNote>
        <schema:description>Funerary ritual or commemorative event for a deceased person of high status, ensuring peaceful transition to Mithiko.</schema:description>
        <schema:name>Hun</schema:name>
    </owl:NamedIndividual>
    


