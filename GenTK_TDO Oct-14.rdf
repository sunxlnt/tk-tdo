        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BeefDish"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledEgg"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FermentedChutney"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PorkDish"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#changban_StickyRiceCake"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#GenderSpecficRole"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chin"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kuki"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizo"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-christian"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Drum"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#goshem_BambooPipe"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Assam"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChinHills"/>
