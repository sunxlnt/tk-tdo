        <SymbolismNote>Continuity between the living and the dead; Communal identity and the belief in the spiritual presence of ancestors who guide and protect the living.</SymbolismNote>
        <TellsStoryOf>Recounts life, deeds, and legacy of the departed; affirms community respect and ancestral relationship.</TellsStoryOf>
        <hasSongNote>Dirge-like memorial songs</hasSongNote>
        <schema:description>Ceremonial observance honoring a deceased elder/chief/warrior; ritual of remembrance and ancestral veneration.</schema:description>
        <schema:name>Vangkho Nitnom</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Vannoi-Lam -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Vannoi-Lam">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#RitualDance"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChristianAttire"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CommunalMeal"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledVegetable"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Rice"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Tea"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#sa-um_MeatStew"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ColonialChristianTradition"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Drum"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Guitar"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Harmonium"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NortheastIndia"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Cultural"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Religious"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChristianHymns"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnChristianOccasion"/>
        <CostumeAttireNote>Modest traditional attire mixed with Christian elements (white garments, crosses, or hymn book in hand)</CostumeAttireNote>
        <FormationNote>Circular formation, representing eternity and the community’s journey in faith</FormationNote>
        <HistoricalOriginNote>(late 19th to early 20th century) after missionary contact</HistoricalOriginNote>
        <MovementNote>Gentle, harmonious steps, involving open arms and bowing heads (symbolizing openness and humility before God)</MovementNote>
        <ParticipantsNote>large groups, especially by church congregations.</ParticipantsNote>
        <PerformedDuringNote>Church foundation day, Christian festivals, dedication services</PerformedDuringNote>
        <RegionalVariationNote>Variation depending on christian denominations</RegionalVariationNote>
        <SymbolismNote>Transition to Christian faith; unity, peace, and spiritual renewal.</SymbolismNote>
        <TellsStoryOf>the contribution of Christianity to the culture</TellsStoryOf>
        <schema:alternateName>lenkhom lam</schema:alternateName>
        <schema:description>A ritualistic dance celebrating the influence of the new faith Christianity on tribal customs and cultural identity.</schema:description>
        <schema:name>Vannoi-Lam</schema:name>
        <rdfs:comment>Christian version of Lamkol</rdfs:comment>
    </owl:NamedIndividual>
    


