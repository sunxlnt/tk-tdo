    <!-- http://tk_tdo.org/ontologies/TK_TDO#Gosem-Lam -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Gosem-Lam">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SeasonalDance"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ThadouAttire"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_HandBeatenDrum"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#IndigenousAnimisticTradition"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-christian"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Cymbals"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_BambooFlute"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_HandBeatenDrum"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Assam"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChinHills"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NagaHills"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Cultural"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Social"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thanksgiving"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AncestralPraiseSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#LawmFestiveSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ThanksgivingChants"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chavang-Kut"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mim-Kut"/>
        <CostumeMen>pheijom (loincloth); Shaipikhup(shawl), Sa o;</CostumeMen>
        <CostumeWomen>ponvei (sarong);  woven blouses; ornaments and headgear specific to their clan or occasion.</CostumeWomen>
        <DanceInstrumentNote>Used to maintain rhythm and invoke energy.</DanceInstrumentNote>
        <FormationNote>circular or linear formations and coordinated footwork.</FormationNote>
        <HistoricalOriginNote>preserved through oral transmission and a vital element of ethnic identity and cultural heritage.</HistoricalOriginNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</MinCount>
        <MovementNote>Graceful, rhythmic, and repetitive steps; in sync with the music</MovementNote>
        <ParticipantsNote>6 to 20 participants</ParticipantsNote>
        <PerformedDuringNote>harvest festivals and social gatherings</PerformedDuringNote>
        <SymbolismNote>unity, joy, and thanksgiving to the Creator for bountiful harvests; cultural marker or identity for the Thadou-Kuki community.</SymbolismNote>
        <TellsStoryOf>The dance recounts the spirit of unity, celebration, and agricultural life of the Thadou people. It often reflects communal joy after a successful harvest or during significant cultural events.</TellsStoryOf>
        <schema:description>traditional dance of the Thadou-Kuki tribe, named after the gosem, a traditional percussion instrument made of wood and animal skin.</schema:description>
        <rdfs:comment>cultural marker of identity for the Thadou-Kuki community.</rdfs:comment>
    </owl:NamedIndividual>
    


