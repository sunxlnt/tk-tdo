        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#changthui_BoiledMeatSoup"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#meipat-sel_RitualMeatOffering"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
