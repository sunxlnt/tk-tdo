        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NortheastIndia"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AncestralPraiseSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HarvestRelatedSongs"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AfterMainHarvest"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PostHarvest"/>
        <CostumeAttireNote>including symbolic ornaments representing agricultural tools or animal motifs</CostumeAttireNote>
        <DurationNote>1–2 days depending on yield and community resources</DurationNote>
        <OriginPlaceNote>Kuki-Zomi groups in Northeast India, primarily Manipur and adjacent regions</OriginPlaceNote>
        <ParticipantsNote>Village community, especially farmers and elders; elders lead the rituals</ParticipantsNote>
        <RegionalVariationNote>Dance and food customs vary slightly by clan and locality</RegionalVariationNote>
        <SymbolismNote>Fertility, prosperity, ancestral continuity, communal joy</SymbolismNote>
        <TellsStoryOf>successful agricultural yield; gratitude to ancestral spirits and nature deities.</TellsStoryOf>
        <hasSongNote>Invocatory chants praising the earth and ancestral protectors</hasSongNote>
        <schema:description>Rich harvest thanksgiving ceremony that marks prosperity and communal abundance.</schema:description>
        <schema:name>Changlha kouna zuphit</schema:name>
    </owl:NamedIndividual>
    


