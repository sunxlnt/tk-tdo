        <AssociatedDance rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Sielpanglap-Lam"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FestiveAttire"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Drum"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#goshem_BambooPipe"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CommunalMeal"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledMeat"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FermentedBambooShoot"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PorkDish"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#job-tears_MilletCake"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#GenderSpecficRole"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#IndigenousAnimisticTradition"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-christian"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#JawHarp"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TraditionalHorn"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_BambooFlute"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#pheiphit_BambooPipe"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Assam"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChinHills"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AncestralPraiseSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SeasonalSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ThanksgivingChants"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Changlai"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Siet-lam"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PostHarvest"/>
        <AssociatedDanceNote>Ritual dances involving animal skull displays and circular movement</AssociatedDanceNote>
        <CostumeAttireNote>including shawls, headgear, ornaments; decorated with harvest motifs</CostumeAttireNote>
        <DurationNote>1–2 days</DurationNote>
        <ParticipantsNote>Entire community; youths, elders, and women with important ritual roles</ParticipantsNote>
        <PerformedDuringNote>Late autumn or post-harvest (typically November)</PerformedDuringNote>
        <RegionalVariationNote>Known as Chang-ai among some clans; practices may differ slightly</RegionalVariationNote>
        <SymbolismNote>Communal joy; reverence and gratitude toward nature, ancestral spirits, and supernatural forces for ensuring agricultural abundance;</SymbolismNote>
        <TellsStoryOf>Community gratitude to nature and ancestral spirits for successful harvest and protection.</TellsStoryOf>
        <schema:alternateName>Chang Ai</schema:alternateName>
        <schema:description>Thanksgiving festival (Feast of Merit) marking completion of grain harvest; especially rice, millet and Job’s tears; includes deliberate slitting of rice bag to spill grains along the path home as reverence.</schema:description>
        <schema:name>Chang Kut</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Chang-Le-Han -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Chang-Le-Han">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SeasonalFestival"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
            </owl:Restriction>
        </rdf:type>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FarmingAttire"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BambooClapper"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SeedRattle"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledYam"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SacrificialMeat"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#job-tears_MilletCake"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#GenderSpecficRole"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Hmar"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#KukiZomi"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#IndigenousAnimisticTradition"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-christian"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TraditionalAgrarianCycle"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_BambooFlute"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#kul_LogDrum"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NorthwesternMyanmar"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AgriculturalChants"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Planting"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PrePlanting"/>
        <AssociatedDanceNote>Group dances (circular/semi-circular), often mimicking sowing or weeding or the offering of first fruits</AssociatedDanceNote>
        <DurationNote>1–3 days;</DurationNote>
        <GenderInclusivityNote>men perform sacrificial rites, women prepare ritual food</GenderInclusivityNote>
        <HistoricalOriginNote>Pre-Christian agricultural belief systems and animistic worldviews</HistoricalOriginNote>
        <ParticipantsNote>Village elders, farmers, youth, and priest/ritual specialist (Thempu)</ParticipantsNote>
        <PerformedDuringNote>Early monsoon/planting season (March–June);  may coincide with sowing rituals or other local festivals</PerformedDuringNote>
        <RegionalVariationNote>Varies in timing, form and costume; some include ritual sowing of millet; others pair with dances and zu wearing festive tribe dress</RegionalVariationNote>
        <SymbolismNote>Agricultural renewal, collective labor, and the relationship between the community and spiritual ecology.</SymbolismNote>
        <TellsStoryOf>Harmony between humans and nature; thanksgiving to spirits of the land (lunglai) and forebears.</TellsStoryOf>
        <hasSongNote>Invocations for rain, protection, and fertility</hasSongNote>
        <schema:description>Seasonal agricultural ritual/festival marking successful planting or early crop growth; , particularly rice or millet; invokes blessings for abundance and protection protection from natural calamities.</schema:description>
        <schema:name>Chang le Han</schema:name>
    </owl:NamedIndividual>
    


