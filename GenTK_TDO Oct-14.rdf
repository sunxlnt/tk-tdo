<?xml version="1.0"?>
<rdf:RDF xmlns="http://tk_tdo.org/ontologies/TK_TDO#"
     xml:base="http://tk_tdo.org/ontologies/TK_TDO"
     xmlns:TK="http://tk_tdo.org/ontologies/TK_TDO#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:schema="http://schema.org/">
    <owl:Ontology rdf:about="http://tk_tdo.org/ontologies/TK_TDO">
        <rdfs:comment>An ontology capturing tribal dance in festivals and rituals among Kuki–Chin–Mizo communities, with instances and relationships for cultural knowledge modeling. 

funded by ICSSR project tled &quot;Developing Knowledge Base Ontology of the Thadou-Kuki Tribe&apos;s Tradi onal Dance.&quot;</rdfs:comment>
        <rdfs:isDefinedBy>Sundari S with inputs from Dr. Mangkhollen Singson</rdfs:isDefinedBy>
        <rdfs:label>Thadou Kuki Tribal Dance Ontology (TK-TDO)</rdfs:label>
        <owl:versionInfo>Version: 1</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://schema.org/alternateName -->

    <owl:AnnotationProperty rdf:about="http://schema.org/alternateName"/>
    


    <!-- http://schema.org/description -->

    <owl:AnnotationProperty rdf:about="http://schema.org/description"/>
    


    <!-- http://schema.org/name -->

    <owl:AnnotationProperty rdf:about="http://schema.org/name"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#AssociatedDance -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#AssociatedDance">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Lam"/>
        <schema:description>Dance form typically associated with the specific festival, ritual, or social event</schema:description>
        <schema:name>Associated Dance</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#CostumeAttire -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#CostumeAttire">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CostumeTradition"/>
        <schema:description>attire and adornment of the perfomers</schema:description>
        <schema:name>Costume Attire</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#DanceInstrument -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#DanceInstrument">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MusicalOrDanceInstrument"/>
        <schema:description>Physical items manipulated during the dance (e.g., swords, bamboo poles).</schema:description>
        <schema:name>Dance Instrument</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#FoodPractice -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#FoodPractice">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FoodTradition"/>
        <schema:description>Food practice typically associated with the specific festival, ritual, or social event</schema:description>
        <schema:name>Food Practice</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#FoodShared -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#FoodShared">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FoodItem"/>
        <schema:description>Food items typically shared in the specific festival, ritual, or social event</schema:description>
        <schema:name>Food Shared</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#GenderInclusivity -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#GenderInclusivity">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gender"/>
        <schema:description>Gender of the performers typically included in performance</schema:description>
        <schema:name>Gender Inclusivity</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#HeritageOf -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#HeritageOf">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#culturalHeritage"/>
        <schema:description>Festivals, rites, or social events typically rooted in or associated with the heritage of a specific clan or tribe</schema:description>
        <schema:name>Heritage Of</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#HistoricalOrigin -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#HistoricalOrigin">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Period"/>
        <schema:alternateName>Historical Origin; period of origination of performance</schema:alternateName>
        <schema:name>Historical Origin</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#MusicalInstrument -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#MusicalInstrument">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MusicalOrDanceInstrument"/>
        <schema:description>An instrument used to produce music during the performance.</schema:description>
        <schema:name>Musical Instrument</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#OriginPlace -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#OriginPlace">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Place"/>
        <schema:description>Geographical origin, a specific place or area wherein the performance is practiced</schema:description>
        <schema:name>Origin Place</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#SportOf -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#SportOf">
        <owl:inverseOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#requiresSport"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <schema:description>Ritual that follows the specific sporting event.</schema:description>
        <schema:name>SportOf</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#TypeOf -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#TypeOf">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NatureOrType"/>
        <schema:description>One or more nature or type of the performance or the occasion (e.g., martial, seasonal).</schema:description>
        <schema:name>Type Of</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#hasSong -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#hasSong">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Song"/>
        <schema:description>Type of song(s) specifically associated with the performance.</schema:description>
        <schema:name>has Song</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#hasSongTitle -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#hasSongTitle">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SongTitle"/>
        <schema:description>Title of the song(s) specifically associated with the performance.</schema:description>
        <schema:name>has Song Title</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#isFormOf -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#isFormOf">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#culturalExpression"/>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#isPerformed -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#isPerformed">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SeasonOrCycle"/>
        <schema:description>Specific festival, ritual, or social event is typically held seasonal, on occasion or death</schema:description>
        <schema:name>Is Perforned</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#linkedRitual -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#linkedRitual">
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kut"/>
        <schema:description>Festivals, rites, or social events in which it is typically performed.</schema:description>
        <schema:name>linked Ritual</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#priorRitualOf -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#priorRitualOf">
        <owl:inverseOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#requiresPriorRitual"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <schema:description>Ritual that follows the specific festival, ritual, or social event.</schema:description>
        <schema:name>priorRitualOf</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#requiresPriorRitual -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#requiresPriorRitual">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kut"/>
        <schema:description>Prior ritual that had to be completed before the specific festival, ritual, or social event.</schema:description>
        <schema:name>requires Prior Ritual</schema:name>
    </owl:ObjectProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#requiresSport -->

    <owl:ObjectProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#requiresSport">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SportingEvent"/>
        <schema:description>Prior sporting event that had to be completed before the specific ritual or event.</schema:description>
        <schema:name>Requires Sport</schema:name>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#AdditionalNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#AdditionalNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Additional infomation on the specific festival, rites or performance</schema:description>
        <schema:name>Additional Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#AssociatedDanceNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#AssociatedDanceNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on dance forms associated with the festival or rites or occasion</schema:description>
        <schema:name>Associated Dance Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#CostumeAttireNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#CostumeAttireNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note for the attire or costume for adornment of the perfomers</schema:description>
        <schema:name>Costume Attire Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#CostumeMen -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#CostumeMen">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on prescribed costume accessories for men</schema:description>
        <schema:name>Costume Men</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#CostumeWomen -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#CostumeWomen">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on prescribed costume accessories for wemen</schema:description>
        <schema:name>Costume Women</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#DanceInstrumentNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#DanceInstrumentNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on physical items manipulated during the dance (e.g., swords, bamboo poles).</schema:description>
        <schema:name>Dance Instrument Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#DurationNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#DurationNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:name>Duration Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#FoodPracticeNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#FoodPracticeNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on traditional Food practices linked with the occasion (e.g., feasting, community shared meal, meal shared after offerings).</schema:description>
        <schema:name>Food Practice Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#FormationNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#FormationNote">
        <schema:description>Note on typical arrangements and spatial patterns of performers.</schema:description>
        <schema:name>Formation Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#GenderInclusivityNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#GenderInclusivityNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on gender inclusivity of performers (e.g. male-only, all genders).</schema:description>
        <schema:name>Gender Inclusivity Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#HistoricalOriginNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#HistoricalOriginNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Notes on the background and context of how a cultural element, practice, or tradition originated in history.</schema:description>
        <schema:name>Historical Origin Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#MinCount -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#MinCount">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <schema:description>Minimum number of participants required for the performance</schema:description>
        <schema:name>Min Count</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#MovementNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#MovementNote">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <schema:description>Note on characteristic movement, A structured or spontaneous bodily action that contributes to a dance form or performance.</schema:description>
        <schema:name>Movement Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#MusicalInstrumentNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#MusicalInstrumentNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on an instrument used to produce music during the performance.</schema:description>
        <schema:name>Musical Instrument Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#NatureOrTypeNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#NatureOrTypeNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on nature or type of the performance or the occasion (e.g., martial, seasonal).</schema:description>
        <schema:name>Nature Or Type Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#OriginPlaceNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#OriginPlaceNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on geographical origin, a specific place or areas whereing the performance is practiced.</schema:description>
        <schema:name>Origin Place Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#ParticipantsNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#ParticipantsNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on typical or prescribed participants.</schema:description>
        <schema:name>Participants Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#PerformedDuringNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#PerformedDuringNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on the period or occasion or festivals the performnce  is being held</schema:description>
        <schema:name>Performed During Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#RegionalNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#RegionalNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on the activities, event, ritual or performace specific to a region</schema:description>
        <schema:name>Regional Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#RegionalVariationNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#RegionalVariationNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on variants in steps, costume, narration, or tempo across regions/clans.</schema:description>
        <schema:name>Regional Variation Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#SeasonalCycleStageNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#SeasonalCycleStageNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note on type or season of the activities, event or rites</schema:description>
        <schema:name>Seasonal Or Cycle Stage Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#SymbolismNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#SymbolismNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Symbolic meanings embodied in the dance or the occasion</schema:description>
        <schema:name>Symbolism Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#TellsStoryOf -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#TellsStoryOf">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Narrative or theme associated with or conveyed by the occasion or the performance.</schema:description>
        <schema:name>Tells Story Of</schema:name>
    </owl:DatatypeProperty>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#hasSongNote -->

    <owl:DatatypeProperty rdf:about="http://tk_tdo.org/ontologies/TK_TDO#hasSongNote">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <schema:description>Note for the song(s) specifically associated with the event or the dance.</schema:description>
        <schema:name>has Song Note</schema:name>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#AgrarianDance -->

    <owl:Class rdf:about="http://tk_tdo.org/ontologies/TK_TDO#AgrarianDance">
        <rdfs:subClassOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Lam"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Agrarian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <schema:description>denote performance related to agrarian or farming activities</schema:description>
        <schema:name>Agrarian Dance</schema:name>
    </owl:Class>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#AgrarianFestival -->

    <owl:Class rdf:about="http://tk_tdo.org/ontologies/TK_TDO#AgrarianFestival">
        <rdfs:subClassOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kut"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Agrarian"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Celebratory"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <schema:description>Denotes Agrarian related event or  festivities or rites</schema:description>
        <schema:name>Agrarian Festival</schema:name>
    </owl:Class>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#AncestralRitual -->

    <owl:Class rdf:about="http://tk_tdo.org/ontologies/TK_TDO#AncestralRitual">
        <rdfs:subClassOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AgrarianFestival"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ancestral"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thanksgiving"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <schema:description>Denotes ancestral reverence related event or  festivities or rites</schema:description>
        <schema:name>Ancestral Ritual</schema:name>
    </owl:Class>
    


