        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SaikulSub-Division"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thanksgiving"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HarvestRelatedSongs"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Heijam-Sap"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ka-Koi-Khai"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AfterSummerHarvest"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PostHarvest"/>
        <AdditionalNote>First state-level Kut celebrated at Keithelmanbi, Sadar Hills under Holkholmang Haokip and (L) Major Pagin Kipgen; secular festival.</AdditionalNote>
        <CostumeMen>Selkap (waistcloth)</CostumeMen>
        <CostumeMen>Vongchawng (jacket)</CostumeMen>
        <CostumeWomen>Ornaments</CostumeWomen>
        <CostumeWomen>Puan (woven wrap-around skirt)</CostumeWomen>
        <CostumeWomen>Shawls</CostumeWomen>
        <DurationNote>1–2 days (some communities up to a week)</DurationNote>
        <HistoricalOriginNote>1961</HistoricalOriginNote>
        <SymbolismNote>Abundance, renewal, thanksgiving, and communal harmony</SymbolismNote>
        <TellsStoryOf>Agricultural prosperity, community unity, and thanksgiving to nature and the divine.</TellsStoryOf>
        <schema:alternateName>Changvang Kut</schema:alternateName>
        <schema:description>Prominent post-harvest festival marking completion of the agricultural cycle and expressing gratitude for a bountiful harvest.</schema:description>
        <schema:name>Chavang Kut</schema:name>
    </owl:NamedIndividual>
    


