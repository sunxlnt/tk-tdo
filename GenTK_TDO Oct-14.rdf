    <!-- http://tk_tdo.org/ontologies/TK_TDO#Mim-Kut -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Mim-Kut">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AncestralRitual"/>
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HarvestFestival"/>
        <AssociatedDance rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Saipi-KhupSuh-Lam"/>
        <AssociatedDance rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Salulap-Lam"/>
        <AssociatedDance rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Sielpanglap-Lam"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Drum"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#goshem_BambooPipe"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#job-tears_MilletCake"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chin"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kuki"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizo"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#IndigenousAnimisticTradition"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-christian"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TraditionalHorn"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#dar_Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_BambooFlute"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AncestralPraiseSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#LamentationChants"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ThanksgivingChants"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chunga"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Jo-mim-kut-taote"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Saichang"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Spring"/>
        <AdditionalNote>The primary festival for people of Nagaland</AdditionalNote>
        <CostumeMen>Headgear with feather or horn motifs</CostumeMen>
        <CostumeWomen>Beadwork</CostumeWomen>
        <CostumeWomen>Woven shawls</CostumeWomen>
        <DurationNote>1–2 days or up to 1 week</DurationNote>
        <HistoricalOriginNote>continued in hybrid forms after Christianization in some regions</HistoricalOriginNote>
        <ParticipantsNote>Entire village, with elders leading the rituals and youth performing songs and dances</ParticipantsNote>
        <RegionalVariationNote>Minor name variations and rituals; in some regions merged with Chavang Kut after Christian influence</RegionalVariationNote>
        <SymbolismNote>Reverence for ancestors, gratitude for harvest, spiritual renewal, and communal unity. Millet (Job’s tears) symbolizes sustenance and the bond between the living and the departed</SymbolismNote>
        <TellsStoryOf>A spiritual communion with ancestors, where every family offers the first fruits from their jhum fields (shifting cultivation) to honor and seek blessings from deceased family members</TellsStoryOf>
        <schema:description>Celebration for the bountiful Job’s tears (millet) harvest; thanksgiving celebration and spiritual communion with ancestors.</schema:description>
        <schema:name>Mim Kut</schema:name>
    </owl:NamedIndividual>
    


