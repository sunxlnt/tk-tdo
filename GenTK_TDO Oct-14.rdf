    <!-- http://tk_tdo.org/ontologies/TK_TDO#Chang-Kut -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Chang-Kut">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FeastOfMerit"/>
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HarvestFestival"/>
