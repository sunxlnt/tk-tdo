        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnOccasion"/>
        <CostumeAttireNote>with headgear and loincloth.</CostumeAttireNote>
        <FormationNote>Linear or semi-circular; sometimes in pairs.</FormationNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</MinCount>
        <MovementNote>Bold, rhythmic, and combat-like.</MovementNote>
        <ParticipantsNote>6–12 male dancers</ParticipantsNote>
        <PerformedDuringNote>Kuki Rising commemorations, tribal festivals.</PerformedDuringNote>
        <RegionalVariationNote>Minor differences in costume and chanting.</RegionalVariationNote>
        <SymbolismNote>Bravery, resistance, and spiritual protection.</SymbolismNote>
        <TellsStoryOf>The Kuki War of Independence (1917–1919).</TellsStoryOf>
        <schema:description>A martial dance performed by Thadou-Kuki men using swords and two-handled blades, symbolizing warfare and defense against evil spirits.</schema:description>
    </owl:NamedIndividual>
    


