        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chavang-Kut"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mim-Kut"/>
        <CostumeAttireNote>hunting attire with trophies</CostumeAttireNote>
        <CostumeWomen>festive handwoven skirts and blouses</CostumeWomen>
        <DanceInstrumentNote>pipe and footwork drive the rhythm.</DanceInstrumentNote>
        <FormationNote>Parallel lines of men and women facing partners.</FormationNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8</MinCount>
        <MovementNote>Sideways wave-like motion with slight knee bends, harmonizing with pipe notations.</MovementNote>
        <MusicalInstrumentNote>producing melodious and rhythmic tunes.</MusicalInstrumentNote>
        <ParticipantsNote>Even numbers, typically 8–16 or more.</ParticipantsNote>
        <PerformedDuringNote>Honoring of great hunters</PerformedDuringNote>
        <RegionalVariationNote>Costume and pipe tunes may vary by locality.</RegionalVariationNote>
        <SymbolismNote>Honor to hunters and communal gratitude.</SymbolismNote>
        <schema:description>Dance celebrating success in hunts, driven by the melodies of bamboo pipes (pheiphit).</schema:description>
        <schema:name>Pheiphit Lam</schema:name>
    </owl:NamedIndividual>
    


