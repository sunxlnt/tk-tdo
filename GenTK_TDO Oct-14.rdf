    <!-- http://tk_tdo.org/ontologies/TK_TDO#culturalExpression -->

    <owl:Class rdf:about="http://tk_tdo.org/ontologies/TK_TDO#culturalExpression">
        <schema:description>Represents the various forms of cultural articulation, including oral traditions, performances, and symbolic representations.</schema:description>
        <schema:name>cultural Expression</schema:name>
    </owl:Class>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#culturalHeritage -->

    <owl:Class rdf:about="http://tk_tdo.org/ontologies/TK_TDO#culturalHeritage">
        <schema:description>Represents the clans or Tribes of Northeast India to mark the events or activities as the heritage of a clan or tribe</schema:description>
        <schema:name>cultural Heritage</schema:name>
    </owl:Class>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#culturalMaterial -->

    <owl:Class rdf:about="http://tk_tdo.org/ontologies/TK_TDO#culturalMaterial">
        <schema:description>Tangible artifacts, objects, and items that hold cultural significance in traditions.</schema:description>
        <schema:name>culutual Material</schema:name>
    </owl:Class>
    


