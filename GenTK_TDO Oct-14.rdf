    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Lom-Juneh -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Lom-Juneh">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PeaceCovenantRitual"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CeremonialAttire"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Rice"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SacrificialMeat"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chin"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kuki"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizo"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CustomaryLawTradition"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Drum"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#goshem_BambooMouthOrgan"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChinStateMyanmar"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PeaceChants"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnOccasion"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PostHarvest"/>
        <AssociatedDanceNote>Solemn processional dances</AssociatedDanceNote>
        <CostumeAttireNote>Ceremonial shawls and symbols of peace (e.g., leaves, spears laid down)</CostumeAttireNote>
        <DurationNote>1–2 days</DurationNote>
        <FoodPracticeNote>Symbolic rice offerings</FoodPracticeNote>
        <ParticipantsNote>Clan elders, youth, and community members; with elders leading;</ParticipantsNote>
        <PerformedDuringNote>Traditionally post-harvest or during communal gatherings when all parties can participate</PerformedDuringNote>
        <RegionalVariationNote>Held as needed after conflict resolution or alliance forging</RegionalVariationNote>
        <SymbolismNote>Peace, Unity and Renewal of trust through ritual feasting and shared obligations</SymbolismNote>
        <TellsStoryOf>Restoration of harmony and reaffirmation of kinship and territorial bonds.</TellsStoryOf>
        <schema:alternateName>Kivah</schema:alternateName>
        <schema:description>Communal ritual marking reconciliation, covenant renewal, or peace settlement between clans or villages.</schema:description>
        <schema:name>Lom Juneh</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Lom-Sel-Neh -->

