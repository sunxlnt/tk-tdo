    <!-- http://tk_tdo.org/ontologies/TK_TDO#Siel-Bot -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Siel-Bot">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SportingEvent"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#WarriorAttire"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SacrificialMeat"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MaleExclusive"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-colonialWarriorTraditions"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#khuang_Drum"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NortheastIndia"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Martial"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#WarriorChants"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Sa-Ai"/>
        <AssociatedDanceNote>Victory dances may follow the successful subduing of the Siel (mithun-Great Indian Bison).</AssociatedDanceNote>
        <CostumeAttireNote>Minimal wear to allow freedom of movement; adorned with symbols of past feats (like animal teeth, feathers, or sashes).</CostumeAttireNote>
        <DurationNote>can vary from a few minutes to half an hour, depending on the challenge and ritual context.</DurationNote>
        <FoodPracticeNote>Sacrificial offering and feasting accompanies the ritual.</FoodPracticeNote>
        <HistoricalOriginNote>rooted in warrior culture and feast-of-merit traditions.</HistoricalOriginNote>
        <ParticipantsNote>Warriors, hunters, or men performing feasts of merit.</ParticipantsNote>
        <PerformedDuringNote>Feasts of merit, celebratory rituals, or public declarations of status.</PerformedDuringNote>
        <RegionalVariationNote>Vary slightly in method and ritual observance among different Kuki clans or regions.</RegionalVariationNote>
        <SymbolismNote>Courage, honor, masculinity, and social ascent through public display of dominance over a culturally valued animal.</SymbolismNote>
        <TellsStoryOf>A man’s bravery, strength, and capacity to perform a feast of merit; symbolizing transition into a position of honor and responsibility within the community.</TellsStoryOf>
        <hasSongNote>Praising the strength and lineage of the performer; songs are sung to encourage the contestant.</hasSongNote>
        <schema:description>Siel Bot is a ritual in Thadou-Kuki society where individuals wrestle a mithun (Siel) to demonstrate strength, valor, and social honor. Performed during feasts of merit, subduing the animal signifies readiness to offer it in sacrifice—a mark of high prestige.</schema:description>
        <schema:name>Siel Bot</schema:name>
    </owl:NamedIndividual>
    


