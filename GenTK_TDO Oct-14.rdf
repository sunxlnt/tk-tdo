    <!-- http://tk_tdo.org/ontologies/TK_TDO#Suhta-Lam -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Suhta-Lam">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#YouthDance"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FestiveAttire"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BambooPoles"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#YouthAllGender"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-colonialAgrarianPractice"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Flute"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#khuang_Drum"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#NortheastIndia"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Celebratory"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CourtshipBallads"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#LawmFestiveSongs"/>
        <CostumeAttireNote>Colorful festive attire; girls often wear wraparounds and headcloths, boys wear traditional shirts and waistcloths.</CostumeAttireNote>
        <FormationNote>Group formation—usually for people handling the bamboo poles and others dancing between them</FormationNote>
        <HistoricalOriginNote>Rooted in agrarian and youth festival traditions; evolved as a celebratory dance of courtship</HistoricalOriginNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</MinCount>
        <MovementNote>dancers step in and out of crossed bamboo poles in rhythmic precision, jumping and turning gracefully.</MovementNote>
        <ParticipantsNote>Performed by 6–10 dancers (even number)</ParticipantsNote>
        <RegionalVariationNote>Known by different names among Mizo, Hmar, and other ethnic groups</RegionalVariationNote>
        <SymbolismNote>Harmony, agility, coordination, and communal bonding.</SymbolismNote>
        <TellsStoryOf>Celebration of youth, vitality, and courtship in traditional village settings and to test who is fit for war.</TellsStoryOf>
        <schema:description>A lively bamboo dance performed mostly by youth, involving rhythmic jumping and stepping between moving bamboo poles.</schema:description>
        <rdfs:comment>Bamboo Dance - On the merit of return from hunting</rdfs:comment>
    </owl:NamedIndividual>
    


