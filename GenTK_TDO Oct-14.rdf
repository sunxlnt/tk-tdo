    <!-- http://tk_tdo.org/ontologies/TK_TDO#Chon -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Chon">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#FeastOfMerit"/>
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MemorialRitual"/>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#CeremonialAttire"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HuntingTools"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Machetes"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TotemicObject_Per_Lineage"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#tengcha_Spear"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#RitualOfferingSharedPostRitual"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MaleExclusive"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Chin"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Kuki"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizo"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-colonialWarriorTraditions"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Drum"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Gong"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Assam"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Eschatological"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#EpicRelatedSongs"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HuntRelatedChants"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnCommemoration"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnOccasion"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PostHunt"/>
        <requiresPriorRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Sa-Ai"/>
        <AssociatedDanceNote>Dramatic ritual movements, slower and more solemn than Sa Ai; gestures representing three successful hunts</AssociatedDanceNote>
        <CostumeAttireNote>embellished with symbols of previous hunts—animal pelts, horns, beads, prestige ornaments</CostumeAttireNote>
        <DurationNote>1 day - spans a full day with ceremonial segments</DurationNote>
        <FoodPracticeNote>Feasting on meat from the hunter’s past trophies;</FoodPracticeNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</MinCount>
        <MusicalInstrumentNote>Played with rhythmic solemnity</MusicalInstrumentNote>
        <OriginPlaceNote>hills of Manipur, Nagaland, Assam and adjoining regions</OriginPlaceNote>
        <ParticipantsNote>Primarily the honored individual (hunter) and male clan members; elders and ritual specialists often officiate</ParticipantsNote>
        <PerformedDuringNote>Special community gatherings or festivals; rare and highly anticipated</PerformedDuringNote>
        <RegionalVariationNote>Some clans may include additional animal sacrifices or community feasts</RegionalVariationNote>
        <SymbolismNote>Sympolizes the transition from earthly valor to eternal honor, ensuring remembrance and reverence by the living.</SymbolismNote>
        <TellsStoryOf>Those who performed Sa Ai three times performs Chon. The performance of Chon guarantees the individual a distinguished place in Mithikhuo ensuring remembrance and reverence by the living.</TellsStoryOf>
        <hasSongNote>Songs recounting the hunter’s exploits, lineage, and spiritual legacy</hasSongNote>
        <schema:description>Ceremony performed by those who have completed Sa Ai three times; confers paramount place in Mithiko (ancestral realm).</schema:description>
        <schema:name>Chon</schema:name>
    </owl:NamedIndividual>
    


