        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Religious"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PrePlanting"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Sa-Ai"/>
        <CostumeMen>traditional shirts and waistcloths</CostumeMen>
        <CostumeWomen>wraparounds and headcloths</CostumeWomen>
        <DanceInstrumentNote>typically emphasis is on voice and movement.; dancers often carry symbolic items (e.g., leaves, sticks).</DanceInstrumentNote>
        <FormationNote>Circular or semi-circular; community elders or priests lead the formation.</FormationNote>
        <GenderInclusivityNote>Primarily male-led, though women may join depending on the region.</GenderInclusivityNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</MinCount>
        <MovementNote>Slow, deliberate, and repetitive steps with raised arms and ritual chants; dancers often carry symbolic items (e.g., leaves, sticks).</MovementNote>
        <MusicalInstrumentNote>minimal, rhythmic accompaniment.</MusicalInstrumentNote>
        <ParticipantsNote>groups of 6–12, often including elders and ritual specialists.</ParticipantsNote>
        <PerformedDuringNote>Ritual events like Sa-Ai, Tolbuk-Ai, or before sowing/harvesting seasons</PerformedDuringNote>
        <RegionalVariationNote>Local variants exist with differing ritual purposes (e.g., invoking rain, healing)</RegionalVariationNote>
        <SymbolismNote>Spiritual intercession, community purification, and renewal of harmony between humans and nature.</SymbolismNote>
        <TellsStoryOf>Appeasement and reverence for ancestral forces believed to guard the community against calamities and ensure good harvest.</TellsStoryOf>
        <hasSongNote>Ancestral invocation chants, usually led by an elder or spiritual guide.</hasSongNote>
        <schema:description>A ritualistic dance centered on invoking protection and blessings from ancestral spirits or nature deities.</schema:description>
    </owl:NamedIndividual>
    


