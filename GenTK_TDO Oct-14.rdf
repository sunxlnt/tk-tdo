    <!-- http://tk_tdo.org/ontologies/TK_TDO#Boncho-Lam -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Boncho-Lam">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MartialDance"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AllGender"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#gosem_BambooFlute"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#khuang_Drum"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#pheiphit_BambooPipe"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#selkai_Gong"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Agrarian"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Cultural"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
        <hasSong rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OralHistoryNarrative"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Boncho-Lam-in-tawh-leh-tungmang"/>
        <hasSongTitle rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#khuong-kai-in-kut-sung-a-len"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnOccasion"/>
        <linkedRitual rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mim-Kut"/>
        <CostumeAttireNote>Ponve / Ponvol, Khamtang / Phurit, Khamcha / Shawl</CostumeAttireNote>
        <FormationNote>lines or circles, moving in unison with one another</FormationNote>
        <MinCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6</MinCount>
        <MovementNote>coordinated steps, creating a lively and harmonious flow, reflecting balance and grace.</MovementNote>
        <ParticipantsNote>performed in groups of 6 to 12 or more,</ParticipantsNote>
        <PerformedDuringNote>Rituals and festivals</PerformedDuringNote>
        <SymbolismNote>social harmony, equality, and collective strength.</SymbolismNote>
        <TellsStoryOf>unity, cultural pride, and joyful celebration among the Thadou Kuki people</TellsStoryOf>
        <schema:description>More than a dance, Boncho-Lam is a narrative in motion, preserving oral history, traditional values, and communal identity through coordinated movements and song.</schema:description>
    </owl:NamedIndividual>
    


