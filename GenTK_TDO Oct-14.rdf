                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <schema:description>Denotes peace-keeping related activities or events held among clans or tribes</schema:description>
        <schema:name>Peace Covenant Ritual</schema:name>
    </owl:Class>
    


