    <!-- http://tk_tdo.org/ontologies/TK_TDO#Kang-Kap -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Kang-Kap">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MusicalCeremony"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TypeOf"/>
                <owl:hasValue rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Ritual"/>
            </owl:Restriction>
        </rdf:type>
        <CostumeAttire rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#TribalAttire"/>
        <DanceInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#kang_Gong"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledMeat"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ForagedGreens"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#PorkDish"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#changban_StickyRiceCake"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MaleExclusive"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Hmar"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#KukiZomi"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-colonialWarriorTraditions"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BambooPercussion"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#kang_Gong"/>
        <MusicalInstrument rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#pong_Drum"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#ChinStateMyanmar"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <isPerformed rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#OnOccasion"/>
        <AssociatedDanceNote>Coordinated movement, sometimes in rows or semi-circle, synchronized with drum/gong beats</AssociatedDanceNote>
        <CostumeAttireNote>Men wear tribal vests (puandum) and shawls; decorative headbands and ornaments</CostumeAttireNote>
        <DurationNote>Multiple rounds during events, each lasting a few minutes</DurationNote>
        <FoodPracticeNote>Feasts shared after performance</FoodPracticeNote>
        <HistoricalOriginNote>used to call warriors or assemble villagers for rituals and emergencies</HistoricalOriginNote>
        <ParticipantsNote>Primarily adult men and youths; women may participate in contemporary cultural performances</ParticipantsNote>
        <PerformedDuringNote>Important festivals (e.g., Hun, Chavang Kut), rituals of mourning, headhunting commemoration (pre-Christian), and community gatherings</PerformedDuringNote>
        <RegionalVariationNote>In some areas, incorporated into modern festival performances; elsewhere remains sacred/commemorative</RegionalVariationNote>
        <SymbolismNote>Communal rhythm represents unity; spiritual calling carry across spiritual realms connecting the living to the ancestors and nature.</SymbolismNote>
        <TellsStoryOf>Community’s collective readiness—for war (historically), festivals, or spiritual invocation; rhythm as social communication.</TellsStoryOf>
        <hasSongNote>Rhythmic patterns and chants accompany the beats (no lyrics required)</hasSongNote>
        <schema:description>Communal ritual or festivity involving rhythmic striking of the Kang (gong); ceremonial and communicative performance.</schema:description>
        <schema:name>Kang Kap</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Kang_kap -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Kang_kap">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SportingEvent"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SnackSharedPostGame"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledRoots"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SeasonalFruits"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MaleExclusive"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <HistoricalOrigin rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Pre-colonial"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Assam"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Recreational"/>
        <CostumeAttireNote>Regular or festive clothing depending on occasion.</CostumeAttireNote>
        <DurationNote>Short rounds lasting 10–20 minutes, multiple games may follow.</DurationNote>
        <HistoricalOriginNote>Traditional recreational activity</HistoricalOriginNote>
        <OriginPlaceNote>Played among Thadou-Kuki communities of North East India</OriginPlaceNote>
        <ParticipantsNote>Primarily Young boys and sometimes older youth; though gender not restricted; occasionally played in pairs or teams.</ParticipantsNote>
        <PerformedDuringNote>During Festivals or during youth dormitory free time</PerformedDuringNote>
        <RegionalVariationNote>Some regions use seeds, others carve small wooden discs.</RegionalVariationNote>
        <SymbolismNote>Agility, accuracy, and playful competition, often fostering communal ties.</SymbolismNote>
        <TellsStoryOf>Recreation and skill-building among youth, often played during gatherings and communal breaks from agricultural work.</TellsStoryOf>
        <hasSongNote>Playful shouts and cheers often accompany the game.</hasSongNote>
        <schema:alternateName>Kang Shanaba</schema:alternateName>
        <schema:description>Kang kap is a traditional game where a wooden disc (Kang) or seed pod (Kangkhils) is struck by hand or stick toward a target, often played by children during festivals and leisure time.</schema:description>
        <schema:name>Kang kap (game)</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Kangchoi-Kap -->

    <owl:NamedIndividual rdf:about="http://tk_tdo.org/ontologies/TK_TDO#Kangchoi-Kap">
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SportingEvent"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SnackSharedPostGame"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#zu_RiceBeer"/>
        <GenderInclusivity rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#MaleExclusive"/>
        <HeritageOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Thadou-Kuki"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Assam"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Manipur"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Mizoram"/>
        <OriginPlace rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Nagaland"/>
        <TypeOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Recreational"/>
        <DurationNote>Game lasts from minutes to hours depending on number of players</DurationNote>
        <FoodPracticeNote>accompanied by light festive snacks or zu (rice beer) in communal gatherings</FoodPracticeNote>
        <HistoricalOriginNote>Long-standing traditional pastime</HistoricalOriginNote>
        <ParticipantsNote>Boys and youth, primarily male, but not strictly gendered</ParticipantsNote>
        <PerformedDuringNote>Leisure time, festivals, after school, and during youth dormitory breaks (Som Zuneh)</PerformedDuringNote>
        <RegionalVariationNote>Top varies in size and material</RegionalVariationNote>
        <SymbolismNote>Represents balance, dexterity, and playful rivalry. The spinning motion is often viewed as symbolic of life&apos;s cycle or energy.</SymbolismNote>
        <TellsStoryOf>A fun competitive game among children and youth that emphasizes skill, precision, and agility.</TellsStoryOf>
        <schema:alternateName>Kangchom Kap</schema:alternateName>
        <schema:description>Traditional spinning top game where players use a string to spin the top and aim to keep it going longest or knock others out of the play area.</schema:description>
        <schema:name>Kangchoi Kap</schema:name>
    </owl:NamedIndividual>
    


    <!-- http://tk_tdo.org/ontologies/TK_TDO#Kangpokpi -->

