        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#AgrarianFestival"/>
        <rdf:type rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#HarvestFestival"/>
        <AssociatedDance rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Lholhun-Lam"/>
        <FoodPractice rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Feasting"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#BoiledHerb"/>
        <FoodShared rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#SmokedMeat"/>
