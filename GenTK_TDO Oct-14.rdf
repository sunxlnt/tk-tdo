        <rdfs:subClassOf rdf:resource="http://tk_tdo.org/ontologies/TK_TDO#Song"/>
        <schema:description>Title of song(s) specifically associated with the performance (jo mim kut taote, Chunga, Saichang songs)</schema:description>
        <schema:name>Song Title</schema:name>
    </owl:Class>
    


